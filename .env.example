# RoastLogs local environment — copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored on purpose and never travels with a clone, so a fresh
# checkout has no keys until you do this. Values come from the Supabase
# dashboard: Project Settings -> API.
#
# Create React App reads .env ONCE at startup. After editing it, stop and
# restart `npm start` — a hot reload will NOT pick up the change.
#
# These are also read by `CI=false npm run build`, so the same .env is what
# `npm run deploy` publishes with. No .env = a keyless bundle on the live site.

# Project URL, e.g. https://<project-ref>.supabase.co
REACT_APP_SUPABASE_URL=

# Publishable / anon key (the sb_pub… value) — safe for the browser bundle.
# This is NOT the service_role key; never put service_role in a client app.
REACT_APP_SUPABASE_ANON_KEY=
